rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Mandatory initial connection verification document
    match /test/connection {
      allow read: if true;
    }

    // User Profile: investigators manage their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Forensic Investigation Notes: private to each authenticated investigator
    match /investigationNotes/{noteId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(noteId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(noteId) && resource.data.userId == request.auth.uid;
    }

    // Watchlist Items: suspect wallets & persons tracked by investigator
    match /watchlistItems/{itemId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid;
    }

    // Watched Wallets: pinned wallets for quick monitoring by investigator on Dashboard
    match /watchedWallets/{walletId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(walletId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(walletId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(walletId) && resource.data.userId == request.auth.uid;
    }
  }
}
